[Desktop Entry]
Type=Application
Name=Cline
Comment=Launch Cline in Ghostty
Exec=ghostty --gtk-single-instance=false --class=io.github.fernandodamaso.smartdock.agent.cline -e cline
Icon=smartdock-agent-cline
Terminal=false
Categories=Development;
Keywords=AI;Agent;Coding;Terminal;
StartupWMClass=io.github.fernandodamaso.smartdock.agent.cline
StartupNotify=true
