[Desktop Entry]
Type=Application
Name=Pi
Comment=Launch Pi in Ghostty
Exec=ghostty --gtk-single-instance=false --class=io.github.fernandodamaso.smartdock.agent.pi -e pi
Icon=smartdock-agent-pi
Terminal=false
Categories=Development;
Keywords=AI;Agent;Coding;Terminal;
StartupWMClass=io.github.fernandodamaso.smartdock.agent.pi
StartupNotify=true
