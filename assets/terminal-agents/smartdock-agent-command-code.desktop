[Desktop Entry]
Type=Application
Name=Command Code
Comment=Launch Command Code in Ghostty
Exec=ghostty --gtk-single-instance=false --class=io.github.fernandodamaso.smartdock.agent.command-code -e commandcode
Icon=smartdock-agent-command-code
Terminal=false
Categories=Development;
Keywords=AI;Agent;Coding;Terminal;
StartupWMClass=io.github.fernandodamaso.smartdock.agent.command-code
StartupNotify=true
