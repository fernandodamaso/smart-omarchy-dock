[Desktop Entry]
Type=Application
Name=Oh My Pi
Comment=Launch Oh My Pi in Ghostty
Exec=ghostty --gtk-single-instance=false --class=io.github.fernandodamaso.smartdock.agent.oh-my-pi -e omp
Icon=smartdock-agent-oh-my-pi
Terminal=false
Categories=Development;
Keywords=AI;Agent;Coding;Terminal;
StartupWMClass=io.github.fernandodamaso.smartdock.agent.oh-my-pi
StartupNotify=true
