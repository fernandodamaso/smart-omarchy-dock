#!/usr/bin/env bash
set -euo pipefail

app_dir="${XDG_DATA_HOME:-$HOME/.local/share}/smartdock"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
config_file="$config_home/smartdock/dock.json"
autostart_file="$config_home/autostart/smartdock.desktop"
launcher_path="$(cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")"

# Standalone launches need the same `qs.*` import mapping that the Omarchy
# shell provides to hosted plugins. Keep the alias in the user's cache and
# leave the packaged Omarchy files untouched.
ensure_omarchy_qml_imports() {
  local omarchy_shell="${OMARCHY_PATH:-/usr/share/omarchy}/shell"
  [[ -d "$omarchy_shell/Commons" && -d "$omarchy_shell/Ui" ]] || return 0

  local import_root="${XDG_CACHE_HOME:-$HOME/.cache}/smartdock/qml-imports"
  install -d "$import_root"
  if [[ ! -e "$import_root/qs" ]]; then
    ln -s "$omarchy_shell" "$import_root/qs"
  fi
  export QML2_IMPORT_PATH="$import_root${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
}

ensure_omarchy_qml_imports

print_help() {
  cat <<'EOF'
SmartDock for Omarchy - a theme-aware application, window, and workspace dock

Usage:
  smartdock [QUICKSHELL OPTIONS]
  smartdock <COMMAND> [OPTION]

Commands:
  help                         Show this help
  autostart enable             Start the dock when the desktop session starts
  autostart disable            Disable automatic startup
  autostart status             Show whether automatic startup is enabled
  update                       Refresh the installed copy from its local source
  restart                      Restart the dock in the background
  stop                         Stop the running dock
  uninstall [--purge]          Uninstall; --purge also removes configuration

Options such as --daemonize and --no-color are passed through to Quickshell
when no command is given.
EOF
  printf '\nConfiguration:\n  %s\n' "$config_file"
}

enable_autostart() {
  install -d "$(dirname -- "$autostart_file")"
  cat >"$autostart_file" <<EOF
[Desktop Entry]
Type=Application
Name=SmartDock for Omarchy
Comment=Theme-aware application, window, and workspace dock for Omarchy
Exec="$launcher_path" --daemonize
OnlyShowIn=Hyprland;
X-GNOME-Autostart-enabled=true
EOF
  chmod 0644 "$autostart_file"
  echo "Autostart enabled: $autostart_file"
}

disable_autostart() {
  rm -f -- "$autostart_file"
  echo "Autostart disabled."
}

autostart() {
  case "${1:-status}" in
    enable) enable_autostart ;;
    disable) disable_autostart ;;
    status)
      if [[ -f "$autostart_file" ]]; then
        echo "Autostart is enabled: $autostart_file"
      else
        echo "Autostart is disabled."
      fi
      ;;
    help|--help|-h)
      cat <<'EOF'
Usage: smartdock autostart <enable|disable|status>

Manage the XDG autostart entry for SmartDock for Omarchy.
EOF
      ;;
    *)
      echo "Unknown autostart action: $1" >&2
      echo "Usage: smartdock autostart <enable|disable|status>" >&2
      exit 2
      ;;
  esac
}

case "${1:-}" in
  help|--help|-h)
    print_help
    exit
    ;;
  autostart)
    autostart "${2:-status}"
    exit
    ;;
  update|--update)
    # Refresh the standalone copy from the installer already on disk. Remote
    # source control belongs to the user's own SmartDock repository.
    if [[ ! -f "$app_dir/install.sh" ]]; then
      echo "smartdock: installer not found at $app_dir/install.sh" >&2
      echo "Run install.sh from your SmartDock source tree." >&2
      exit 1
    fi
    if [[ -f "$autostart_file" ]]; then
      bash "$app_dir/install.sh"
    else
      bash "$app_dir/install.sh" --no-autostart
    fi
    exit
    ;;
  stop|--stop)
    qs kill -p "$app_dir" --any-display >/dev/null 2>&1 || true
    exit
    ;;
  restart|--restart)
    qs kill -p "$app_dir" --any-display >/dev/null 2>&1 || true
    shift
    exec env SMARTDOCK_CONFIG="$config_file" qs -n -d -p "$app_dir" "$@"
    ;;
  uninstall|--uninstall)
    shift
    exec "$app_dir/uninstall.sh" "$@"
    ;;
esac

if [[ ! -f "$app_dir/shell.qml" ]]; then
  echo "smartdock: application files not found; run the installer again" >&2
  exit 1
fi

exec env SMARTDOCK_CONFIG="$config_file" qs -n -p "$app_dir" "$@"
