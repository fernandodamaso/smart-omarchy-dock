#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Demand-driven SmartDock-owned local Herdr provider.

The process is started only while a SmartDock consumer is active. It resolves
local Herdr sessions, supervises one read-only helper per unique socket and emits
versioned normalized JSON lines. It never imports or controls omaherdr.
"""
from __future__ import annotations

from collections import deque
import argparse
import json
import os
from pathlib import Path
import queue
import select
import signal
import subprocess
import sys
import threading
import time
import uuid

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
sys.path.insert(0, str(ROOT))

from discovery import Discovery  # noqa: E402
from model import ServerState, normalized_snapshot  # noqa: E402
from attachments import (  # noqa: E402
    discover_attachment_inventory,
    parse_provider_focus_agent_command,
    parse_window_processes_command,
    resolve_window_identities,
)
from remote import (  # noqa: E402
    HELPER_LEASE_RENEW_EVERY,
    REMOTE_BOOTSTRAP_TIMEOUT,
    REMOTE_PROBE_TIMEOUT,
    RemoteResolution,
    RemoteResolverPool,
    attachment_key as remote_attachment_key,
    endpoint_id as remote_endpoint_id,
    helper_ssh_argv,
)

MAX_HELPER_FRAME = 1024 * 1024
MAX_QUEUE_BYTES = 2 * 1024 * 1024
MAX_SOURCE_QUEUE_BYTES = MAX_HELPER_FRAME
MAX_REMOTE_QUEUE_BYTES = MAX_HELPER_FRAME
MAX_HELPER_STDIN_BYTES = 64 * 1024
MAX_OUTPUT_FRAME = 1024 * 1024
DISCOVERY_CHECK_EVERY = 10.0
SAFETY_SNAPSHOT_EVERY = 60.0
OUTPUT_TIMEOUT = 2.0


class BoundedQueue:
    """Bounded event queue with a reserved local lane and per-source caps."""

    def __init__(self, max_bytes: int = MAX_QUEUE_BYTES) -> None:
        self.max_bytes = max_bytes
        self.bytes = 0
        self.items: deque[tuple[object, int, str | None, str | None]] = deque()
        self.source_bytes: dict[str, int] = {}
        self.lane_bytes: dict[str, int] = {"local": 0, "remote": 0}
        self.cv = threading.Condition()
        self.control_waiters = 0

    def put(self, value: object, size: int) -> bool:
        """Compatibility data enqueue without lane accounting."""
        return self._put_data(value, size, None, None, fair=False)

    def put_data(self, value: object, size: int, source: str, lane: str) -> bool:
        if lane not in ("local", "remote") or not source:
            return False
        return self._put_data(value, size, source, lane, fair=True)

    def _put_data(
        self,
        value: object,
        size: int,
        source: str | None,
        lane: str | None,
        *,
        fair: bool,
    ) -> bool:
        if size < 0 or size > self.max_bytes:
            return False
        with self.cv:
            if self.control_waiters > 0 or self.bytes + size > self.max_bytes:
                return False
            if fair and source is not None and lane is not None:
                if self.source_bytes.get(source, 0) + size > min(
                    MAX_SOURCE_QUEUE_BYTES, self.max_bytes
                ):
                    return False
                # Remote sources cannot consume the local half of the queue.
                if lane == "remote" and self.lane_bytes["remote"] + size > min(
                    MAX_REMOTE_QUEUE_BYTES, self.max_bytes // 2
                ):
                    return False
            self.items.append((value, size, source, lane))
            self.bytes += size
            if fair and source is not None and lane is not None:
                self.source_bytes[source] = self.source_bytes.get(source, 0) + size
                self.lane_bytes[lane] += size
            self.cv.notify()
            return True

    def put_wait(self, value: object, size: int) -> bool:
        """Bounded backpressure for non-lossy control/lifecycle events."""
        if size < 0 or size > self.max_bytes:
            return False
        with self.cv:
            self.control_waiters += 1
            try:
                while self.bytes + size > self.max_bytes:
                    self.cv.wait()
                self.items.append((value, size, None, None))
                self.bytes += size
                self.cv.notify()
                return True
            finally:
                self.control_waiters -= 1

    def get(self, timeout: float | None = None) -> object:
        deadline = None if timeout is None else time.monotonic() + timeout
        with self.cv:
            while not self.items:
                if deadline is None:
                    self.cv.wait()
                else:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        raise queue.Empty
                    self.cv.wait(remaining)
            value, size, source, lane = self.items.popleft()
            self.bytes -= size
            if source is not None and lane is not None:
                remaining = self.source_bytes.get(source, 0) - size
                if remaining > 0:
                    self.source_bytes[source] = remaining
                else:
                    self.source_bytes.pop(source, None)
                self.lane_bytes[lane] = max(0, self.lane_bytes[lane] - size)
            self.cv.notify_all()
            return value

    def get_nowait(self) -> object:
        return self.get(0)


class HelperProcess:
    def __init__(
        self,
        server_id: str,
        socket_path: str,
        token: int,
        events: BoundedQueue,
        helper_path: Path,
        *,
        transport: str = "local",
        target: str = "",
    ) -> None:
        self.server_id = server_id
        self.socket_path = socket_path
        self.token = token
        self.events = events
        self.helper_path = helper_path
        self.transport = transport if transport in ("local", "remote") else "local"
        self.target = target
        self.process: subprocess.Popen[bytes] | None = None
        self.overflowed = False
        self.thread: threading.Thread | None = None
        self._write_lock = threading.Lock()
        self._write_frames: deque[bytes] = deque()
        self._write_offset = 0
        self._write_bytes = 0

    def start(self) -> bool:
        try:
            if self.transport == "remote":
                helper_source = self.helper_path.read_bytes()
                argv = helper_ssh_argv(self.target, self.socket_path, helper_source)
            else:
                argv = [sys.executable, "-B", str(self.helper_path), self.socket_path]
            self.process = subprocess.Popen(
                argv,
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            assert self.process.stdin is not None
            os.set_blocking(self.process.stdin.fileno(), False)
        except (OSError, ValueError):
            self.process = None
            return False
        self.thread = threading.Thread(target=self._pump, args=(self.process,), daemon=True)
        self.thread.start()
        return True

    def _pump(self, process: subprocess.Popen[bytes]) -> None:
        assert process.stdout is not None
        while True:
            line = process.stdout.readline(MAX_HELPER_FRAME + 2)
            if not line:
                break
            if len(line) > MAX_HELPER_FRAME + 1 or not line.endswith(b"\n"):
                self.overflowed = True
                self._terminate(process)
                break
            try:
                message = json.loads(line)
            except (ValueError, UnicodeError):
                continue
            if not isinstance(message, dict):
                continue
            event = ("helper", self.server_id, self.token, message)
            if hasattr(self.events, "put_data"):
                accepted = self.events.put_data(
                    event, len(line), self.server_id, self.transport
                )
            else:
                accepted = self.events.put(event, len(line))
            if not accepted and self.transport == "local":
                # Preserve local behavior under remote pressure: local helper
                # data backpressures instead of being killed by the remote lane.
                accepted = self.events.put_wait(event, len(line))
            if not accepted:
                self.overflowed = True
                self._terminate(process)
                break
        code = process.wait()
        self.events.put_wait(("exit", self.server_id, self.token, code, self.overflowed), 128)

    def send(self, command: str | bytes | bytearray) -> bool:
        process = self.process
        if not process or process.poll() is not None or process.stdin is None:
            return False
        try:
            payload = bytes(command) if isinstance(command, (bytes, bytearray)) else command.encode("utf-8")
        except (UnicodeError, TypeError):
            return False
        if not payload.endswith(b"\n"):
            payload += b"\n"
        if len(payload) > MAX_HELPER_FRAME:
            return False
        self.flush()
        with self._write_lock:
            if self._write_bytes + len(payload) > MAX_HELPER_STDIN_BYTES:
                return False
            self._write_frames.append(payload)
            self._write_bytes += len(payload)
        self.flush()
        return True

    def flush(self) -> None:
        process = self.process
        if not process or process.poll() is not None or process.stdin is None:
            return
        fd = process.stdin.fileno()
        with self._write_lock:
            for _ in range(16):
                if not self._write_frames:
                    return
                frame = self._write_frames[0]
                try:
                    written = os.write(fd, memoryview(frame)[self._write_offset:self._write_offset + 65536])
                except (BlockingIOError, InterruptedError):
                    return
                except OSError:
                    return
                if written <= 0:
                    return
                self._write_offset += written
                self._write_bytes -= written
                if self._write_offset == len(frame):
                    self._write_frames.popleft()
                    self._write_offset = 0

    @staticmethod
    def _terminate(process: subprocess.Popen[bytes]) -> None:
        if process.poll() is not None:
            return
        try:
            os.killpg(process.pid, signal.SIGTERM)
        except (OSError, ProcessLookupError):
            try:
                process.terminate()
            except OSError:
                pass

    def abort(self) -> None:
        process = self.process
        if process is not None:
            self._terminate(process)

    def stop(self) -> None:
        process = self.process
        if not process:
            return
        if process.poll() is None:
            self.send("quit")
            deadline = time.monotonic() + 0.8
            while process.poll() is None and time.monotonic() < deadline:
                self.flush()
                time.sleep(0.02)
            if process.poll() is None:
                self._terminate(process)
                try:
                    process.wait(timeout=0.5)
                except subprocess.TimeoutExpired:
                    try:
                        os.killpg(process.pid, signal.SIGKILL)
                    except OSError:
                        process.kill()
                    process.wait(timeout=0.5)
        if self.thread and self.thread is not threading.current_thread():
            self.thread.join(timeout=1)


class Provider:
    def __init__(
        self,
        helper_path: Path,
        discovery: Discovery | None = None,
        remote_pool: RemoteResolverPool | None = None,
    ) -> None:
        self.helper_path = helper_path
        self.discovery = discovery or Discovery()
        self.remote_pool = remote_pool or RemoteResolverPool()
        self.events = BoundedQueue()
        self.states: dict[str, ServerState] = {}
        self.helpers: dict[str, HelperProcess] = {}
        self.helper_tokens: dict[str, int] = {}
        self.restart_at: dict[str, float] = {}
        self.backoff: dict[str, float] = {}
        self.last_safety: dict[str, float] = {}
        self.discovery_error = ""
        self.epoch = uuid.uuid4().hex
        self.revision = 0
        self.stopping = False
        self.dirty = True
        self.next_discovery_check = time.monotonic() + DISCOVERY_CHECK_EVERY
        self.stdin_thread: threading.Thread | None = None
        self.window_process_revision = 0
        self.window_process_pids: list[int] = []
        self.window_process_identities: list[dict[str, int]] = []
        self.remote_specs: dict[str, dict[str, object]] = {}
        self.remote_tokens: dict[str, int] = {}
        self.remote_bindings: dict[str, str] = {}
        self.remote_pending_ids: dict[str, str] = {}
        self.remote_resolve_retry_at: dict[str, float] = {}
        self.remote_resolve_backoff: dict[str, float] = {}
        self.remote_probe_deadline: dict[str, float] = {}
        self.remote_bootstrap_deadline: dict[str, float] = {}
        self.remote_last_lease: dict[str, float] = {}

    def _stdin(self) -> None:
        for raw in sys.stdin.buffer:
            command = raw.strip()
            if len(command) > 4096:
                continue
            if command in (b"refresh", b"quit"):
                self.events.put_wait(("command", command.decode("ascii")), len(command) + 64)
                if command == b"quit":
                    return
                continue
            parsed = parse_window_processes_command(command)
            if parsed is not None:
                self.events.put_wait(("window-processes", parsed), len(command) + 64)
                continue
            focus = parse_provider_focus_agent_command(command)
            if focus is not None:
                self.events.put_wait(("focus-agent", focus), len(command) + 64)
                continue
        self.events.put_wait(("command", "quit"), 64)

    def scan(self) -> None:
        infos, error = self.discovery.scan()
        self.discovery_error = error
        incoming: dict[str, dict[str, object]] = {}
        for source in infos:
            info = dict(source)
            info.setdefault("transport", "local")
            info.setdefault("host", "local")
            info.setdefault("capabilities", {"focusAgent": True})
            incoming[str(info["id"])] = info

        for server_id in list(self.states):
            state = self.states[server_id]
            if state.info.get("transport", "local") == "remote":
                continue
            if server_id in incoming:
                state.info = incoming[server_id]
                continue
            self._remove_server(server_id)

        for server_id, info in incoming.items():
            if server_id not in self.states:
                self.states[server_id] = ServerState(info)
                self.backoff[server_id] = 1.0
                self.start_helper(server_id, replace=False)
        self.refresh_attachments(list(incoming.values()))
        self.dirty = True

    def refresh_attachments(self, infos: list[dict[str, object]] | None = None) -> None:
        """Refresh verified local/remote TUI attachments on every scan cadence."""
        inventory = infos
        if inventory is None:
            inventory = [
                state.info for state in self.states.values()
                if state.info.get("transport", "local") == "local"
            ]
        rows = discover_attachment_inventory(inventory)
        local: dict[str, list[dict[str, object]]] = {}
        remote: dict[str, dict[str, object]] = {}

        for row in rows:
            client = row.get("client")
            if not isinstance(client, dict):
                continue
            if row.get("kind") == "local":
                server_id = row.get("serverId")
                if isinstance(server_id, str):
                    bucket = local.setdefault(server_id, [])
                    if len(bucket) < 16 and not any(
                        item.get("pid") == client.get("pid")
                        and item.get("startTime") == client.get("startTime")
                        for item in bucket
                    ):
                        bucket.append(client)
                continue

            target = row.get("target")
            session = row.get("session")
            if not isinstance(target, str) or not isinstance(session, str):
                continue
            try:
                key = remote_attachment_key(target, session)
            except ValueError:
                continue
            group = remote.setdefault(key, {
                "target": target,
                "session": session,
                "clients": [],
                "executables": set(),
            })
            clients = group["clients"]
            if isinstance(clients, list) and len(clients) < 16 and not any(
                item.get("pid") == client.get("pid")
                and item.get("startTime") == client.get("startTime")
                for item in clients if isinstance(item, dict)
            ):
                clients.append(client)
            executable = row.get("herdrExecutable")
            if isinstance(executable, str) and executable:
                group["executables"].add(executable)

        changed = False
        for server_id, state in self.states.items():
            if state.info.get("transport", "local") != "local":
                continue
            clients = local.get(server_id, [])
            if state.clients != clients:
                state.clients = clients
                changed = True

        normalized_remote: dict[str, dict[str, object]] = {}
        for key, group in remote.items():
            executables = group.pop("executables")
            group["herdrExecutable"] = (
                next(iter(executables)) if isinstance(executables, set) and len(executables) == 1
                else None
            )
            normalized_remote[key] = group
        if self.reconcile_remote_attachments(normalized_remote):
            changed = True
        if self.refresh_window_processes():
            changed = True
        if changed:
            self.dirty = True

    def _pending_remote_id(self, key: str) -> str:
        return "remote-pending-" + key.removeprefix("remote-attachment-")

    def _remove_server(self, server_id: str) -> None:
        self.helper_tokens[server_id] = self.helper_tokens.get(server_id, 0) + 1
        helper = self.helpers.pop(server_id, None)
        if helper:
            helper.stop()
        state = self.states.pop(server_id, None)
        if state is not None and (state.connected or state.snapshot is not None):
            state.invalidate_connection("removed")
        self.restart_at.pop(server_id, None)
        self.backoff.pop(server_id, None)
        self.last_safety.pop(server_id, None)
        self.remote_probe_deadline.pop(server_id, None)
        self.remote_bootstrap_deadline.pop(server_id, None)
        self.remote_last_lease.pop(server_id, None)

    def _remove_remote_key(self, key: str) -> None:
        self.remote_tokens[key] = self.remote_tokens.get(key, 0) + 1
        self.remote_specs.pop(key, None)
        self.remote_resolve_retry_at.pop(key, None)
        self.remote_resolve_backoff.pop(key, None)
        pending_id = self.remote_pending_ids.pop(key, None)
        if pending_id is not None and pending_id in self.states:
            self._remove_server(pending_id)
        server_id = self.remote_bindings.pop(key, None)
        if server_id is None:
            return
        if server_id not in self.remote_bindings.values():
            self._remove_server(server_id)
        else:
            self._refresh_remote_server_info(server_id)

    def _schedule_remote_resolution(self, key: str, now: float | None = None) -> bool:
        spec = self.remote_specs.get(key)
        if spec is None or key in self.remote_bindings:
            return False
        now = time.monotonic() if now is None else now
        target = spec.get("target")
        session = spec.get("session")
        executable = spec.get("herdrExecutable")
        pending_id = self.remote_pending_ids.get(key)
        pending = self.states.get(pending_id) if pending_id else None
        if not isinstance(executable, str) or not executable:
            if pending is not None:
                pending.error = "remote_herdr_unavailable"
            delay = self.remote_resolve_backoff.get(key, 1.0)
            self.remote_resolve_retry_at[key] = now + delay
            self.remote_resolve_backoff[key] = min(30.0, delay * 2)
            return False
        if not isinstance(target, str) or not isinstance(session, str):
            return False
        token = self.remote_tokens.get(key, 0) + 1
        self.remote_tokens[key] = token
        if not self.remote_pool.submit(key, token, target, session, executable):
            if pending is not None:
                pending.error = "resolver_busy"
            delay = self.remote_resolve_backoff.get(key, 1.0)
            self.remote_resolve_retry_at[key] = now + delay
            self.remote_resolve_backoff[key] = min(30.0, delay * 2)
            return False
        if pending is not None:
            pending.error = "resolving"
        self.remote_resolve_retry_at.pop(key, None)
        return True

    def reconcile_remote_attachments(self, incoming: dict[str, dict[str, object]]) -> bool:
        changed = False
        for key in list(self.remote_specs):
            if key not in incoming:
                self._remove_remote_key(key)
                changed = True

        for key, source in incoming.items():
            spec = {
                "target": source.get("target"),
                "session": source.get("session"),
                "herdrExecutable": source.get("herdrExecutable"),
                "clients": list(source.get("clients") or [])[:16],
            }
            previous = self.remote_specs.get(key)
            self.remote_specs[key] = spec
            server_id = self.remote_bindings.get(key)
            if server_id is not None:
                if previous != spec:
                    self._refresh_remote_server_info(server_id)
                    changed = True
                continue

            pending_id = self.remote_pending_ids.get(key)
            if pending_id is None:
                pending_id = self._pending_remote_id(key)
                self.remote_pending_ids[key] = pending_id
                target = str(spec.get("target") or "")
                session = str(spec.get("session") or "default")
                state = ServerState({
                    "id": pending_id,
                    "transport": "remote",
                    "host": target,
                    "session": session,
                    "sessions": [session],
                    "label": target,
                    "socket": "",
                    "capabilities": {"focusAgent": False},
                })
                state.error = "resolving"
                state.clients = list(spec["clients"])
                self.states[pending_id] = state
                self.remote_resolve_backoff[key] = 1.0
                self._schedule_remote_resolution(key)
                changed = True
            else:
                state = self.states.get(pending_id)
                if state is not None and state.clients != spec["clients"]:
                    state.clients = list(spec["clients"])
                    changed = True
                if previous is not None and previous.get("herdrExecutable") != spec.get("herdrExecutable"):
                    self._schedule_remote_resolution(key)
                    changed = True
        return changed

    def _refresh_remote_server_info(self, server_id: str) -> None:
        state = self.states.get(server_id)
        if state is None:
            return
        keys = sorted(key for key, bound in self.remote_bindings.items() if bound == server_id)
        specs = [self.remote_specs[key] for key in keys if key in self.remote_specs]
        if not specs:
            return
        targets = sorted({str(spec.get("target") or "") for spec in specs if spec.get("target")})
        sessions = sorted({str(spec.get("session") or "default") for spec in specs})
        host = targets[0] if targets else "remote"
        state.info["host"] = host
        state.info["sessions"] = sessions
        state.info["session"] = sessions[0] if sessions else "default"
        state.info["label"] = host if len(sessions) <= 1 else host + " · " + ", ".join(sessions[:3])
        clients: list[dict[str, object]] = []
        seen: set[tuple[object, object]] = set()
        for spec in specs:
            for client in spec.get("clients") or []:
                if not isinstance(client, dict):
                    continue
                identity = (client.get("pid"), client.get("startTime"))
                if identity in seen or len(clients) >= 16:
                    continue
                seen.add(identity)
                clients.append(client)
        state.clients = clients

    def apply_remote_resolution(self, key: str, token: int, result: RemoteResolution) -> None:
        if self.remote_tokens.get(key) != token or key not in self.remote_specs:
            return
        spec = self.remote_specs[key]
        pending_id = self.remote_pending_ids.get(key)
        pending = self.states.get(pending_id) if pending_id else None
        if not result.ok:
            if pending is not None:
                pending.error = result.error or "remote_metadata_unavailable"
            delay = self.remote_resolve_backoff.get(key, 1.0)
            self.remote_resolve_retry_at[key] = time.monotonic() + delay
            self.remote_resolve_backoff[key] = min(30.0, delay * 2)
            self.dirty = True
            return

        target = str(spec.get("target") or "")
        session = str(spec.get("session") or "default")
        try:
            server_id = remote_endpoint_id(result.authority, result.socket, target)
        except ValueError:
            if pending is not None:
                pending.error = "remote_metadata_invalid"
            self.dirty = True
            return

        previous_server = self.remote_bindings.get(key)
        if pending_id is not None:
            self.remote_pending_ids.pop(key, None)
            if pending_id in self.states:
                self._remove_server(pending_id)

        self.remote_bindings[key] = server_id
        self.remote_resolve_retry_at.pop(key, None)
        self.remote_resolve_backoff[key] = 1.0

        if server_id not in self.states:
            info = {
                "id": server_id,
                "transport": "remote",
                "host": target,
                "session": session,
                "sessions": [session],
                "label": target,
                "socket": result.socket,
                "herdrExecutable": result.executable,
                "remoteAuthority": result.authority,
                "capabilities": {"focusAgent": False},
            }
            self.states[server_id] = ServerState(info)
            self.backoff[server_id] = 1.0
            self._refresh_remote_server_info(server_id)
            self.start_helper(server_id, replace=False)
        else:
            state = self.states[server_id]
            state.info["socket"] = result.socket
            state.info["herdrExecutable"] = result.executable
            state.info["remoteAuthority"] = result.authority
            self._refresh_remote_server_info(server_id)

        if previous_server is not None and previous_server != server_id:
            if previous_server not in self.remote_bindings.values():
                self._remove_server(previous_server)
            else:
                self._refresh_remote_server_info(previous_server)
        self.dirty = True

    def drain_remote_results(self) -> None:
        for key, token, result in self.remote_pool.poll():
            self.apply_remote_resolution(key, token, result)

    def refresh_window_processes(self) -> bool:
        """Re-resolve requested window PIDs through the opened proc reader."""
        identities = resolve_window_identities(self.window_process_pids)
        if identities == self.window_process_identities:
            return False
        self.window_process_identities = identities
        return True

    def apply_window_processes(self, request: dict[str, object]) -> None:
        revision = request.get("revision")
        pids = request.get("pids")
        if not isinstance(revision, int) or isinstance(revision, bool) or revision < 0:
            return
        if not isinstance(pids, list):
            return
        self.window_process_revision = revision
        self.window_process_pids = [int(pid) for pid in pids if isinstance(pid, int)]
        self.refresh_window_processes()
        self.dirty = True

    def emit_action_result(self, request_id: str, ok: bool, error: str = "") -> None:
        code = error if isinstance(error, str) and error else ""
        if ok:
            code = ""
        elif code not in (
            "invalid_request", "inventory_reconciling", "agent_gone", "identity_mismatch",
            "server_unavailable", "timeout", "provider_unavailable", "unsupported",
            "unsupported_command",
        ):
            code = "unsupported"
        payload = {
            "kind": "action-result",
            "requestId": request_id,
            "ok": ok is True,
            "error": code,
        }
        frame = (
            json.dumps(payload, separators=(",", ":"), ensure_ascii=True, allow_nan=False) + "\n"
        ).encode("utf-8")
        view = memoryview(frame)
        deadline = time.monotonic() + OUTPUT_TIMEOUT
        while view:
            remaining = deadline - time.monotonic()
            if remaining <= 0 or not select.select([], [sys.stdout], [], remaining)[1]:
                raise BrokenPipeError("provider output unavailable")
            written = os.write(sys.stdout.fileno(), view[:65536])
            if written <= 0:
                raise BrokenPipeError("provider output unavailable")
            view = view[written:]

    def apply_focus_agent(self, request: dict[str, object]) -> None:
        request_id = str(request.get("requestId") or "")
        if not request_id:
            return
        if request.get("providerEpoch") != self.epoch:
            self.emit_action_result(request_id, False, "identity_mismatch")
            return
        server_id = str(request.get("serverId") or "")
        state = self.states.get(server_id)
        if state is None:
            self.emit_action_result(request_id, False, "server_unavailable")
            return
        capabilities = state.info.get("capabilities")
        if not isinstance(capabilities, dict) or capabilities.get("focusAgent") is not True:
            self.emit_action_result(request_id, False, "unsupported")
            return
        if not state.live:
            self.emit_action_result(request_id, False, "server_unavailable")
            return
        # Do not block on snapshot_due. Status and post-focus structural events
        # set that flag constantly; agent/pane/terminal checks below already
        # fail closed if inventory no longer contains the captured identity.
        generation = request.get("connectionGeneration")
        if generation != state.generation:
            self.emit_action_result(request_id, False, "identity_mismatch")
            return
        agents = state.live_agents(time.monotonic())
        if agents is None:
            self.emit_action_result(request_id, False, "server_unavailable")
            return
        agent_id = str(request.get("agentId") or "")
        pane_id = str(request.get("paneId") or "")
        terminal_id = str(request.get("terminalId") or "")
        match = None
        for agent in agents:
            if agent.get("id") != agent_id:
                continue
            if agent.get("paneId") != pane_id:
                continue
            if terminal_id and agent.get("terminalId", "") != terminal_id:
                continue
            match = agent
            break
        if match is None:
            self.emit_action_result(request_id, False, "agent_gone")
            return
        helper = self.helpers.get(server_id)
        if not helper:
            self.emit_action_result(request_id, False, "server_unavailable")
            return
        command = json.dumps({
            "kind": "focus-agent",
            "requestId": request_id,
            "pane_id": pane_id,
        }, separators=(",", ":"), ensure_ascii=True)
        if not helper.send(command):
            self.emit_action_result(request_id, False, "server_unavailable")

    def start_helper(self, server_id: str, replace: bool = True) -> None:
        state = self.states.get(server_id)
        if not state:
            return
        previous = self.helpers.pop(server_id, None)
        if previous:
            previous.stop()
        if replace:
            state.replace_connection()
        token = self.helper_tokens.get(server_id, 0) + 1
        self.helper_tokens[server_id] = token
        transport = state.info.get("transport", "local")
        helper = HelperProcess(
            server_id,
            str(state.info.get("socket") or ""),
            token,
            self.events,
            self.helper_path,
            transport="remote" if transport == "remote" else "local",
            target=str(state.info.get("host") or "") if transport == "remote" else "",
        )
        self.helpers[server_id] = helper
        now = time.monotonic()
        self.last_safety[server_id] = now
        if helper.start():
            self.restart_at.pop(server_id, None)
            if transport == "remote":
                self.remote_last_lease[server_id] = now
                self.remote_bootstrap_deadline[server_id] = now + REMOTE_BOOTSTRAP_TIMEOUT
                helper.send("lease")
        else:
            state.connected = False
            state.snapshot = None
            state.error = "helper_unavailable"
            delay = self.backoff.get(server_id, 1.0)
            self.restart_at[server_id] = now + delay
            self.backoff[server_id] = min(30.0, delay * 2)
        self.dirty = True

    def fail_helper(self, server_id: str, error: str) -> None:
        state = self.states.get(server_id)
        if state is None:
            return
        self.helper_tokens[server_id] = self.helper_tokens.get(server_id, 0) + 1
        helper = self.helpers.pop(server_id, None)
        if helper:
            helper.abort()
        state.invalidate_connection(error)
        delay = self.backoff.get(server_id, 1.0)
        self.restart_at[server_id] = time.monotonic() + delay
        self.backoff[server_id] = min(30.0, delay * 2)
        self.remote_probe_deadline.pop(server_id, None)
        self.remote_bootstrap_deadline.pop(server_id, None)
        self.dirty = True

    def process_event(self, event: object) -> None:
        if not isinstance(event, tuple) or not event:
            return
        kind = event[0]
        if kind == "command":
            command = event[1]
            if command == "quit":
                self.stopping = True
            elif command == "refresh":
                self.scan()
            return
        if kind == "window-processes":
            request = event[1]
            if isinstance(request, dict):
                self.apply_window_processes(request)
            return
        if kind == "focus-agent":
            request = event[1]
            if isinstance(request, dict):
                self.apply_focus_agent(request)
            return
        if kind not in ("helper", "exit"):
            return

        server_id, token = str(event[1]), int(event[2])
        if self.helper_tokens.get(server_id) != token:
            return
        state = self.states.get(server_id)
        if not state:
            return

        if kind == "exit":
            overflowed = bool(event[4])
            self.helpers.pop(server_id, None)
            state.invalidate_connection("helper_overflow" if overflowed else "helper_exited")
            delay = self.backoff.get(server_id, 1.0)
            self.restart_at[server_id] = time.monotonic() + delay
            self.backoff[server_id] = min(30.0, delay * 2)
            self.remote_probe_deadline.pop(server_id, None)
            self.remote_bootstrap_deadline.pop(server_id, None)
            self.dirty = True
            return

        message = event[3]
        now = time.monotonic()
        message_kind = message.get("kind")
        if message_kind == "action-result":
            request_id = message.get("requestId")
            if isinstance(request_id, str) and request_id:
                self.emit_action_result(
                    request_id,
                    message.get("ok") is True,
                    str(message.get("error") or ""),
                )
            return
        if message_kind == "snapshot":
            if state.info.get("transport") == "remote":
                self.remote_probe_deadline.pop(server_id, None)
            state.apply_snapshot(message, now)
        elif message_kind == "status":
            state.apply_status(message)
            if state.connected:
                self.backoff[server_id] = 1.0
        elif message_kind == "event":
            state.apply_event(message, now)
        else:
            return
        if state.info.get("transport") == "remote" and state.live:
            self.remote_bootstrap_deadline.pop(server_id, None)
        self.dirty = True

    def maintenance(self) -> None:
        now = time.monotonic()
        self.drain_remote_results()

        if now >= self.next_discovery_check:
            self.next_discovery_check = now + DISCOVERY_CHECK_EVERY
            if self.discovery.changed():
                self.scan()
            else:
                # Attachment process identity changes independently of local sockets.
                self.refresh_attachments()

        for key, retry_at in list(self.remote_resolve_retry_at.items()):
            if now >= retry_at and key in self.remote_specs and key not in self.remote_bindings:
                self._schedule_remote_resolution(key, now)

        for server_id, state in list(self.states.items()):
            helper = self.helpers.get(server_id)
            if helper:
                helper.flush()

            bootstrap_deadline = self.remote_bootstrap_deadline.get(server_id)
            if bootstrap_deadline is not None and now >= bootstrap_deadline and not state.live:
                self.fail_helper(server_id, "bootstrap_timeout")
                continue

            deadline = self.remote_probe_deadline.get(server_id)
            if deadline is not None and now >= deadline:
                self.fail_helper(server_id, "probe_timeout")
                continue

            restart_at = self.restart_at.get(server_id)
            if restart_at is not None and now >= restart_at:
                self.start_helper(server_id, replace=False)
                continue

            is_remote = state.info.get("transport") == "remote"
            if is_remote and helper is not None:
                last_lease = self.remote_last_lease.get(server_id, 0.0)
                if now - last_lease >= HELPER_LEASE_RENEW_EVERY:
                    if helper.send("lease"):
                        self.remote_last_lease[server_id] = now

            if state.snapshot_due is not None and now >= state.snapshot_due:
                state.snapshot_due = None
                if helper and helper.send("snapshot"):
                    self.last_safety[server_id] = now
                    if is_remote:
                        self.remote_probe_deadline[server_id] = now + REMOTE_PROBE_TIMEOUT

            if now - self.last_safety.get(server_id, now) >= SAFETY_SNAPSHOT_EVERY:
                if helper and helper.send("snapshot"):
                    self.last_safety[server_id] = now
                    if is_remote:
                        self.remote_probe_deadline[server_id] = now + REMOTE_PROBE_TIMEOUT

    def emit(self) -> None:
        self.revision += 1
        payload = normalized_snapshot(
            self.epoch,
            self.revision,
            [self.states[key] for key in sorted(self.states)],
            self.discovery_error,
            window_processes={
                "revision": self.window_process_revision,
                "identities": list(self.window_process_identities),
            },
        )
        frame = (
            json.dumps(payload, separators=(",", ":"), ensure_ascii=False, allow_nan=False) + "\n"
        ).encode("utf-8")

        if len(frame) > MAX_OUTPUT_FRAME:
            payload["agents"] = []
            payload["attention"] = []
            payload["liveCounts"] = None
            payload["completeness"] = {
                "state": "partial",
                "truncated": True,
                "serverTruncated": payload["completeness"].get("serverTruncated", False),
                "agentTruncated": True,
            }
            payload["sourceErrorCode"] = "normalized_output_too_large"
            frame = (
                json.dumps(payload, separators=(",", ":"), ensure_ascii=False) + "\n"
            ).encode("utf-8")
        if len(frame) > MAX_OUTPUT_FRAME:
            raise RuntimeError("normalized output exceeds hard limit")

        view = memoryview(frame)
        deadline = time.monotonic() + OUTPUT_TIMEOUT
        while view:
            remaining = deadline - time.monotonic()
            if remaining <= 0 or not select.select([], [sys.stdout], [], remaining)[1]:
                raise BrokenPipeError("provider output unavailable")
            written = os.write(sys.stdout.fileno(), view[:65536])
            if written <= 0:
                raise BrokenPipeError("provider output unavailable")
            view = view[written:]
        self.dirty = False

    def shutdown(self) -> None:
        self.stopping = True
        self.remote_pool.close()
        helpers = list(self.helpers.values())
        self.helpers.clear()
        for helper in helpers:
            helper.stop()

    def run(self) -> None:
        self.stdin_thread = threading.Thread(target=self._stdin, daemon=True)
        self.stdin_thread.start()
        self.scan()
        try:
            while not self.stopping:
                if self.dirty:
                    self.emit()
                try:
                    event = self.events.get(timeout=0.1)
                except queue.Empty:
                    event = None
                if event is not None:
                    self.process_event(event)
                    while True:
                        try:
                            self.process_event(self.events.get_nowait())
                        except queue.Empty:
                            break
                self.maintenance()
        finally:
            self.shutdown()


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--helper",
        default=str(HERE / "smartdock-herdr-helper"),
        help=argparse.SUPPRESS,
    )
    args = parser.parse_args()
    provider = Provider(Path(args.helper))

    def stop(_signum: int, _frame: object) -> None:
        provider.stopping = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        provider.run()
    except (BrokenPipeError, KeyboardInterrupt):
        provider.shutdown()


if __name__ == "__main__":
    main()
